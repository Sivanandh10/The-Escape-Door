# The Escape Door — environment variables. Copy to .env.local for local dev.
# On Netlify: Site configuration → Environment variables (scope: Builds + Functions).
# NEXT_PUBLIC_* values are inlined at BUILD time — redeploy after changing them.
# Never commit real secrets. Everything works with these left empty (seed catalogue, no storage).

# Public site origin, no trailing slash. Used for canonical URLs, sitemap, OG and JSON-LD.
# Empty → Netlify's build var URL → http://localhost:3100 under `next dev` →
# https://the-escape-door.netlify.app (CONTRACTS §10.13). Set it when a custom domain goes live.
NEXT_PUBLIC_SITE_URL=

# WhatsApp number for orders, international format, digits only (e.g. 91XXXXXXXXXX).
# Empty → the "Buy on WhatsApp" link opens WhatsApp without a recipient (customer picks the chat).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (free tier). Project Settings → API.
# Empty → catalogue comes from src/lib/data/seed.ts, leads return { stored: false },
# uploads return 503 "uploads-unconfigured" (the Forge falls back to "send the file on WhatsApp").
NEXT_PUBLIC_SUPABASE_URL=
# Public key: the new "publishable" key (sb_publishable_…) or the legacy "anon" JWT. Either name works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY — bypasses RLS. Used by /api/lead, /api/upload-url and netlify/functions/track.
# The new "secret" key (sb_secret_…) or the legacy "service_role" JWT. Either name works.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# First-party analytics endpoint (Netlify Function with geo; never stores IPs).
# Default when empty: /.netlify/functions/track  (404s harmlessly under `next dev`).
NEXT_PUBLIC_TRACK_ENDPOINT=

# Optional third-party analytics (free). Leave empty to disable.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Comma-separated owner emails allowed into /admin (in addition to the `admins` table check).
ADMIN_EMAILS=
