// Renders the brand React components to static files (public/brand/*.svg, icons/PNGs).
// Run: npx -y tsx scripts/brand/export-brand.mts [--preview]
//   --preview  only writes qa/f3a/preview-*.png (for visual iteration)
import fs from 'node:fs'
import path from 'node:path'
import { createElement as h } from 'react'
import { renderToStaticMarkup } from 'react-dom/server'
import sharp from 'sharp'
import * as WM from '../../src/components/brand/Wordmark'
import * as BM from '../../src/components/brand/Badge'
// the components compile to CJS under tsx (package has no type:module) → unwrap interop
const pick = <T,>(m: unknown, k: string): T => ((m as Record<string, unknown>)[k] ?? ((m as { default: Record<string, unknown> }).default)[k]) as T
const Wordmark = pick<typeof WM.Wordmark>(WM, 'Wordmark')
const Badge = pick<typeof BM.Badge>(BM, 'Badge')

const root = path.resolve(import.meta.dirname, '../..')
const preview = process.argv.includes('--preview')
const NOTE = '<!-- RECREATION — replace with original vector files. Generated by scripts/brand/export-brand.mts -->\n'

const svgOf = (el: Parameters<typeof renderToStaticMarkup>[0], wpx?: number, hpx?: number) => {
  let s = renderToStaticMarkup(el)
  if (wpx) s = s.replace('<svg ', `<svg width="${wpx}" height="${hpx ?? wpx}" `)
  return s
}
const png = (svg: string, out: string, density = 72) => sharp(Buffer.from(svg), { density }).png({ compressionLevel: 9 }).toFile(out)

const marks = {
  full: svgOf(h(Wordmark, { variant: 'full' })),
  bracket: svgOf(h(Wordmark, { variant: 'bracket' })),
  stacked: svgOf(h(Wordmark, { variant: 'stacked' })),
  inline: svgOf(h(Wordmark, { variant: 'inline' })),
  badge: svgOf(h(Badge, {})),
}

if (preview) {
  const dir = path.join(root, 'qa/f3a')
  fs.mkdirSync(dir, { recursive: true })
  await png(svgOf(h(Wordmark, { variant: 'full' }), 1040, 880), path.join(dir, 'preview-full.png'))
  await png(svgOf(h(Wordmark, { variant: 'stacked' }), 600, 472), path.join(dir, 'preview-stacked.png'))
  await png(svgOf(h(Wordmark, { variant: 'inline' }), 1002, 162), path.join(dir, 'preview-inline.png'))
  await png(svgOf(h(Badge, {}), 600, 600), path.join(dir, 'preview-badge.png'))
  for (const s of [16, 32, 64, 180]) await png(svgOf(h(Wordmark, { variant: 'bracket' }), s, s), path.join(dir, `preview-bracket-${s}.png`))
  console.log('preview written')
} else {
  const brand = path.join(root, 'public/brand')
  fs.mkdirSync(brand, { recursive: true })
  const write = (f: string, s: string) => fs.writeFileSync(path.join(brand, f), NOTE + s)
  write('wordmark.svg', marks.full)
  write('wordmark-stacked.svg', marks.stacked)
  write('wordmark-inline.svg', marks.inline)
  write('wordmark-bracket.svg', marks.bracket)
  write('favicon.svg', marks.bracket)
  write('badge.svg', marks.badge)
  fs.writeFileSync(path.join(root, 'src/app/icon.svg'), NOTE + marks.bracket)
  const icon = (s: number) => svgOf(h(Wordmark, { variant: 'bracket' }), s, s)
  await png(icon(192), path.join(brand, 'icon-192.png'))
  await png(icon(512), path.join(brand, 'icon-512.png'))
  await png(icon(180), path.join(brand, 'apple-touch-icon.png'))
  await png(icon(180), path.join(root, 'src/app/apple-icon.png'))
  await png(svgOf(h(Badge, {}), 512, 512), path.join(brand, 'badge-512.png'))
  // favicon.ico — PNG-compressed ICO (16/32/48) from the bracket mark (replaces the create-next-app icon)
  const sizes = [16, 32, 48]
  const pngs = await Promise.all(sizes.map((s) => sharp(Buffer.from(icon(s)), { density: 72 }).png({ compressionLevel: 9 }).toBuffer()))
  const head = Buffer.alloc(6 + 16 * sizes.length)
  head.writeUInt16LE(0, 0)
  head.writeUInt16LE(1, 2)
  head.writeUInt16LE(sizes.length, 4)
  let offset = head.length
  sizes.forEach((s, i) => {
    const e = 6 + i * 16
    head.writeUInt8(s, e)
    head.writeUInt8(s, e + 1)
    head.writeUInt16LE(1, e + 4) // planes
    head.writeUInt16LE(32, e + 6) // bpp
    head.writeUInt32LE(pngs[i].length, e + 8)
    head.writeUInt32LE(offset, e + 12)
    offset += pngs[i].length
  })
  fs.writeFileSync(path.join(root, 'src/app/favicon.ico'), Buffer.concat([head, ...pngs]))
  console.log('brand files written')
}
